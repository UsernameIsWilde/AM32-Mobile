<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- matches the web UI background (tailwind gray-950) so there is no white flash on start -->
    <color name="app_background">#030712</color>

    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:colorAccent">#DC2626</item>
    </style>
</resources>
