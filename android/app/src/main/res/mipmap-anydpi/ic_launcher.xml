<?xml version="1.0" encoding="utf-8"?>
<!-- Android 7.x (no adaptive icons): red rounded square with the white logo on top -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ic_launcher_background" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item
        android:bottom="5dp"
        android:drawable="@drawable/am32_logo"
        android:left="5dp"
        android:right="5dp"
        android:top="5dp" />
</layer-list>
